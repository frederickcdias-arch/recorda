# ==============================================================
# Recorda — Variáveis de Ambiente para Homologação / Piloto
# ==============================================================
# INSTRUÇÕES:
#   1. Copie este arquivo para .env (NÃO commite o .env real)
#   2. Preencha todos os valores marcados com [PREENCHER]
#   3. Nunca commite segredos reais neste repositório
#
# Geração de secrets seguros:
#   JWT_SECRET:           openssl rand -base64 48
#   VAPID keys:           npm run push:vapid
# ==============================================================

# ── Ambiente ────────────────────────────────────────────────
NODE_ENV=production
TZ=America/Sao_Paulo

# ── Servidor ────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0

# ── Banco de dados ──────────────────────────────────────────
# Opção 1 (recomendada para Railway — usa DATABASE_URL):
DATABASE_URL=postgresql://[PREENCHER_USUARIO]:[PREENCHER_SENHA]@[PREENCHER_HOST]:5432/[PREENCHER_BANCO]

# Opção 2 (variáveis individuais — usar se não houver DATABASE_URL):
# DB_HOST=[PREENCHER_HOST]
# DB_PORT=5432
# DB_NAME=[PREENCHER_BANCO]
# DB_USER=[PREENCHER_USUARIO]
# DB_PASSWORD=[PREENCHER_SENHA]

# SSL do banco (Railway PostgreSQL usa SSL — deixar as linhas abaixo comentadas para usar o padrão)
# DB_SSL=false                        # descomente APENAS se o servidor não suportar SSL
# DB_SSL_REJECT_UNAUTHORIZED=false    # descomente para certs autoassinados

# ── Autenticação ────────────────────────────────────────────
# [OBRIGATÓRIO] Gerar com: openssl rand -base64 48
JWT_SECRET=[PREENCHER_SECRET_FORTE_MIN_32_CHARS]

# ── CORS ────────────────────────────────────────────────────
# [OBRIGATÓRIO] URL exata do frontend sem barra final
# Producao principal: CORS_ORIGIN=https://recorda.company
# Fallback temporario suportado: CORS_ORIGIN=https://recorda.company,https://recorda-six.vercel.app
CORS_ORIGIN=https://recorda.company

# ── URL da aplicação (usada em e-mails de reset de senha) ───
# [OBRIGATÓRIO] Mesma URL do frontend
APP_URL=https://recorda.company

# ── Frontend (Vercel / build) ───────────────────────────────
# [OBRIGATÓRIO] URL pública do backend
# Preferencial: https://api.recorda.company
# Temporario: https://[PREENCHER_DOMINIO_BACKEND_RAILWAY]
VITE_API_BASE=https://api.recorda.company

# Versão exibida na AdminPage (opcional)
# VITE_APP_VERSION=hml-1.0.0

# ── Push Notifications / PWA ────────────────────────────────
# Deixar em branco para desabilitar push no ambiente de homologação.
# Para habilitar: npm run push:vapid e copiar os valores gerados.
VAPID_PUBLIC_KEY=[PREENCHER_CHAVE_PUBLICA_VAPID]
VAPID_PRIVATE_KEY=[PREENCHER_CHAVE_PRIVADA_VAPID]
VAPID_SUBJECT=mailto:[PREENCHER_EMAIL_RESPONSAVEL]
VITE_VAPID_PUBLIC_KEY=[PREENCHER_CHAVE_PUBLICA_VAPID]

# ── E-mail (SMTP) ────────────────────────────────────────────
# Sem SMTP_HOST configurado, e-mails são logados no console (modo desenvolvimento).
# Configurar para receber e-mails de reset de senha em homologação.
# SMTP_HOST=[PREENCHER]
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=[PREENCHER]
# SMTP_PASS=[PREENCHER]
# SMTP_FROM=noreply@[PREENCHER_DOMINIO]

# ── OpenAI — Captura de Mapas ────────────────────────────────
# Manter desabilitado em homologação a menos que a feature seja testada.
OPENAI_IMAGE_ENABLED=false
# OPENAI_API_KEY=[PREENCHER SE NECESSÁRIO]
OPENAI_IMAGE_MODEL=gpt-4.1-mini
OPENAI_IMAGE_TIMEOUT_MS=10000
OPENAI_IMAGE_MAX_WIDTH=1600
OPENAI_IMAGE_JPEG_QUALITY=82
OPENAI_IMAGE_AUTO_CROP_ENABLED=true
OPENAI_IMAGE_MIN_CORNER_CONFIDENCE=0.75
OPENAI_IMAGE_MIN_DOCUMENT_AREA_RATIO=0.28

# ── Scan fiel de mapas (determinístico, sem IA generativa) ───
MAP_IMAGE_FAITHFUL_SCAN_ENABLED=true
MAP_IMAGE_BLOCK_GENERATIVE_REPLACEMENT=true
MAP_IMAGE_FAITHFUL_MAX_DIMENSION=1600
MAP_IMAGE_FAITHFUL_DOCUMENT_RATIO=A1_PORTRAIT
MAP_IMAGE_LOCAL_PROCESSOR_TIMEOUT_MS=12000
MAP_IMAGE_TOTAL_PROCESSING_TIMEOUT_MS=18000
MAP_IMAGE_AI_WARP_TIMEOUT_MS=5000

# ── Processador de documentos (Python/OpenCV — legado) ───────
# Manter desabilitado. Não instalar Python no container Docker.
DOCUMENT_PROCESSOR_ENABLED=false
DOCUMENT_PROCESSOR_RUNTIME=python
DOCUMENT_PROCESSOR_PYTHON=python
DOCUMENT_PROCESSOR_SCRIPT=packages/backend/python/document_processor.py
DOCUMENT_PROCESSOR_TEMP_DIR=.tmp/document-processor

# ── Admin inicial (apenas para script create-admin-user.js) ──
# NÃO usar aqui para subir o servidor. Usar somente ao executar o script
# manualmente: ADMIN_EMAIL=... ADMIN_PASSWORD=... node scripts/create-admin-user.js
# ADMIN_EMAIL=[PREENCHER_EMAIL_ADMIN]
# ADMIN_PASSWORD=[PREENCHER_SENHA_FORTE]
# ADMIN_NAME=Administrador

# ── Debug (opcional) ────────────────────────────────────────
# RECORDA_IMPORT_DEBUG=1
