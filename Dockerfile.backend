# Multi-stage build for backend production
FROM node:20-alpine AS base

# Install dependencies only when needed
FROM base AS deps
WORKDIR /app

# Copy package files
COPY package*.json ./
COPY packages/backend/package*.json ./packages/backend/
COPY packages/shared/package*.json ./packages/shared/
COPY scripts/ ./scripts/

# Install dependencies (--ignore-scripts skips husky/prepare in CI)
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

# Build the application
FROM base AS builder
WORKDIR /app

# Copy all source files
COPY . .

# Install all dependencies (including dev)
RUN npm ci

# Build shared first so backend runtime artifacts and type declarations exist in clean CI builds
RUN npm run build --workspace=@recorda/shared && npm run build --workspace=@recorda/backend

# Production stage
FROM node:20-alpine AS runner
WORKDIR /app

# su-exec lets the entrypoint drop from root to nodejs after fixing volume ownership
RUN apk add --no-cache su-exec

# Create non-root user
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nodejs

# Copy built application
COPY --from=deps /app/node_modules ./node_modules
COPY --from=builder --chown=nodejs:nodejs /app/packages/backend/dist ./packages/backend/dist
COPY --from=builder --chown=nodejs:nodejs /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder --chown=nodejs:nodejs /app/packages/backend/package*.json ./packages/backend/
COPY --from=builder --chown=nodejs:nodejs /app/packages/shared/package*.json ./packages/shared/

# Copy database migrations
COPY --chown=nodejs:nodejs db ./db

# Create upload directories with proper ownership before switching user
RUN mkdir -p /app/uploads/planilhas \
    /app/uploads/ocr \
    /app/uploads/ocr-recebimento \
    /app/uploads/ausencias \
    /app/uploads/logos \
    /app/uploads/relatorios \
    /app/uploads/mapas \
    && chown -R nodejs:nodejs /app/uploads

# Set environment variables
ENV NODE_ENV=production
ENV PORT=3001
ENV UPLOADS_DIR=/app/uploads

COPY --chown=nodejs:nodejs docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh

# Stay root here: the entrypoint re-chowns /app/uploads (which may be a
# volume mount that arrives owned by root) before dropping to nodejs.
ENTRYPOINT ["/app/docker-entrypoint.sh"]

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3001/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) })"

# Expose port
EXPOSE 3001

# Run migrations then start the application
CMD ["sh", "-c", "node packages/backend/dist/infrastructure/database/migrate.js && node packages/backend/dist/main.js"]
