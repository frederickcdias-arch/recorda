# ============================================
# Recorda Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# Variables marked [REQUIRED in prod] must be set for production.

# ── General ──────────────────────────────────
NODE_ENV=development          # development | staging | production
TZ=America/Sao_Paulo

# ── Server ───────────────────────────────────
PORT=3000
HOST=0.0.0.0

# ── Database ─────────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_NAME=recorda
DB_USER=recorda
DB_PASSWORD=recorda           # [REQUIRED in prod]

# ── Authentication ───────────────────────────
JWT_SECRET=change-me-to-a-random-secret   # [REQUIRED in prod] min 32 chars

# ── CORS ─────────────────────────────────────
CORS_ORIGIN=https://recorda.local   # [REQUIRED in prod] frontend URL

# ── Application URL (used in emails) ────────
APP_URL=http://localhost:5173       # [REQUIRED in prod] e.g. https://recorda.local

# ── Email (SMTP) ─────────────────────────────
# If SMTP_HOST is not set, emails are logged to console (dev mode).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false             # true for port 465
# SMTP_USER=user@example.com
# SMTP_PASS=secret
# SMTP_FROM=noreply@recorda.local

# ── Database SSL (production) ─────────────────────
# DB_SSL=false                  # Set to 'false' to disable SSL in production
# DB_SSL_REJECT_UNAUTHORIZED=false  # Set to 'false' for self-signed certs

# ── Debug ────────────────────────────────────────
# RECORDA_IMPORT_DEBUG=1        # Enable import debug logging

# ── OpenAI — Captura de Mapas (POC) ────────────
OPENAI_IMAGE_ENABLED=false
# OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-4.1-mini
OPENAI_IMAGE_TIMEOUT_MS=10000
OPENAI_IMAGE_MAX_WIDTH=1600
OPENAI_IMAGE_JPEG_QUALITY=82
OPENAI_IMAGE_AUTO_CROP_ENABLED=true
OPENAI_IMAGE_MIN_CORNER_CONFIDENCE=0.75
OPENAI_IMAGE_MIN_DOCUMENT_AREA_RATIO=0.28
MAP_IMAGE_AI_WARP_TIMEOUT_MS=5000

# Timeouts — Captura de Mapas
MAP_IMAGE_LOCAL_PROCESSOR_TIMEOUT_MS=12000
MAP_IMAGE_TOTAL_PROCESSING_TIMEOUT_MS=18000

# Scan fiel (determinístico, sem IA generativa) — padrão para mapas/plantas
MAP_IMAGE_FAITHFUL_SCAN_ENABLED=true
MAP_IMAGE_BLOCK_GENERATIVE_REPLACEMENT=true
MAP_IMAGE_FAITHFUL_MAX_DIMENSION=1600
MAP_IMAGE_FAITHFUL_DOCUMENT_RATIO=A1_PORTRAIT
